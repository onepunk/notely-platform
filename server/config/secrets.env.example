# Notely Platform Secrets - EXAMPLE TEMPLATE
#
# Copy this file to secrets.env and fill in your actual values.
# NEVER commit secrets.env to version control!
#
# This file contains ONLY secrets (passwords, API keys, tokens).
# Non-secret configuration (usernames, ports, etc.) is in base.env.

# ============================================================================
# Security Secrets (Auto-generated on first deployment, then preserved)
# ============================================================================

# JWT token signing secret (32+ characters recommended)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_32_characters_minimum

# RSA private/public key pair for JWT signing (PEM encoded with literal \n escapes)
# Generate with: ./scripts/generate-secrets.sh or openssl
# IMPORTANT: Must be quoted to prevent bash interpretation
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_your_private_key\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace_with_your_public_key\n-----END PUBLIC KEY-----"
# Optional explicit key identifier (otherwise derived automatically)
JWT_KEY_ID=

# Encryption key for data at rest (64 characters - hex encoded 32 bytes)
# Generate with: openssl rand -hex 64
ENCRYPTION_KEY=your_encryption_key_here_64_characters_hex_encoded

# ============================================================================
# Service-to-Service Authentication
# ============================================================================

# Gateway API key for obtaining service tokens from Auth service
# This key authenticates the gateway to request service-level access tokens
# Generate with: openssl rand -hex 32
GATEWAY_SERVICE_API_KEY=your_gateway_service_api_key_here_64_chars

# Internal API key for CI/CD and service-to-service communication
# Used by GitHub Actions to sync releases to database after deployment
# Also add this to GitHub repository secrets as INTERNAL_API_KEY
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=your_internal_api_key_here_64_chars

# HMAC-SHA256 key for signed release download URLs
# Used by portal-bff (signing) and nginx (validation)
# Generate with: openssl rand -hex 32
RELEASES_SIGNING_KEY=your_releases_signing_key_here_64_chars

# ============================================================================
# Database Configuration
# ============================================================================
# NOTE: Database names and usernames are defined in base.env (not secrets)
# Only passwords are stored here

# PostgreSQL admin password
POSTGRES_PASSWORD=your_secure_postgres_admin_password

# Service-specific database role passwords (usernames defined in base.env)
POSTGRES_AUTH_PASSWORD=your_auth_service_password
POSTGRES_USERS_PASSWORD=your_users_service_password
POSTGRES_CALENDAR_PASSWORD=your_calendar_service_password
POSTGRES_MEETINGS_PASSWORD=your_meetings_service_password
POSTGRES_TRANSCRIPTS_PASSWORD=your_transcripts_service_password
POSTGRES_NOTES_PASSWORD=your_notes_service_password
POSTGRES_SUMMARIES_PASSWORD=your_summaries_service_password
POSTGRES_ADMIN_SERVICE_PASSWORD=your_admin_service_password
POSTGRES_ACTIONS_PASSWORD=your_actions_service_password
POSTGRES_PORTAL_PASSWORD=your_portal_service_password
POSTGRES_ADMIN_DATABASE_PASSWORD=your_admin_database_service_password
POSTGRES_EMAIL_PASSWORD=your_email_service_password

# Redis password
REDIS_PASSWORD=your_redis_password

# RabbitMQ credentials
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_ERLANG_COOKIE=your_erlang_cookie_here

# ============================================================================
# Microsoft OAuth - Environment-Specific Configuration
# ============================================================================
#
# Microsoft OAuth credentials are now managed PER-ENVIRONMENT to support
# separate Azure AD app registrations for development vs production.
#
# WHY SEPARATE APPS?
# - Development apps have callbacks with :8443 port (e.g., api.yourdomain.com:8443)
# - Production apps use standard HTTPS (e.g., api.yourdomain.com)
# - Azure AD validates callback URLs exactly, so you need different apps
#
# HOW TO CONFIGURE:
# - Development (--dev flag):  Copy secrets.dev.env.example -> secrets.dev.env
# - Production (--production): Copy secrets.prod.env.example -> secrets.prod.env
# - Staging (--staging):       Create secrets.staging.env (optional)
#
# The environment-specific file overrides MICROSOFT_CLIENT_ID and
# MICROSOFT_CLIENT_SECRET from this file.
#
# This file keeps MICROSOFT_TENANT and MICROSOFT_OIDC_SCOPE as shared defaults.
# ============================================================================

# App Name: Notely Platform (fallback if no environment-specific file)
# Redirect URI: https://YOUR_API_DOMAIN/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=your_shared_microsoft_app_id
MICROSOFT_CLIENT_SECRET=your_shared_microsoft_app_secret
MICROSOFT_TENANT=your_microsoft_tenant_id_or_common

# Microsoft OIDC scope for authentication
MICROSOFT_OIDC_SCOPE="openid profile email offline_access https://graph.microsoft.com/User.Read"

# If you are using a single shared Azure AD app registration across services,
# reuse the MICROSOFT_CLIENT_ID/SECRET values for the Teams bot, Graph client,
# and Outlook calendar sections below.

# ============================================================================
# Microsoft OAuth - Mailer App (Application Permissions)
# Used for sending emails on behalf of the organization
# ============================================================================

# App Name: Notely Mailer (App-only)
# Redirect URI: https://YOUR_API_DOMAIN/api/desktop-auth/microsoft/callback
MAIL_APP_CLIENT_ID=your_mail_app_client_id_here
MAIL_APP_CLIENT_SECRET=your_mail_app_client_secret_here
MAIL_TENANT_ID=your_mail_tenant_id_here

# Email configuration for sending
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=
MICROSOFT_SENDER_EMAIL=noreply@yourdomain.com

# ============================================================================
# Google OAuth (Optional - for Google Calendar integration)
# ============================================================================

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://YOUR_API_DOMAIN/api/calendar/google/callback

# ============================================================================
# External Services (Optional)
# ============================================================================

# Hugging Face token for AI model downloads
HUGGINGFACE_TOKEN=your_huggingface_token

# Custom package repository configuration (for private PyPI mirrors)
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=
CUSTOM_CA_PEM=

# ============================================================================
# Azure Communication Services (ACS) - For Teams Meeting Join
# ============================================================================

# ACS endpoint (required for managed identity authentication in production)
# Format: https://<resource-name>.<region>.communication.azure.com
ACS_ENDPOINT=https://your-acs-resource.region.communication.azure.com

# ACS resource ID for Teams allowlisting (immutable resource ID from Azure portal)
# Find this in: Azure Portal -> ACS Resource -> Properties -> Immutable Resource ID
ACS_RESOURCE_ID=your-acs-immutable-resource-id-guid

# ACS connection string (OPTIONAL - local development only)
# Production uses managed identity authentication via DefaultAzureCredential
# Only populate this for local testing/development
# Find in: Azure Portal -> ACS Resource -> Keys
ACS_CONNECTION_STRING=

# ACS Call Automation webhook shared secret (optional but recommended)
# Generate with: openssl rand -hex 32
ACS_JOINER_WEBHOOK_SECRET=your_acs_joiner_webhook_secret_here_32_chars_minimum

# Teams ACS worker callback secret (optional - for callback request validation)
# Generate with: openssl rand -hex 32
TEAMS_ACS_CALLBACK_SECRET=your_teams_acs_callback_secret_here_32_chars_minimum

# ============================================================================
# ACS Teams User Identity Authentication (Service Account)
# ============================================================================

# Service account for authenticated ACS joins (removes "Unverified" label)
# This account must exist in the same tenant as your ACS resource and have a Teams license
ACS_SERVICE_ACCOUNT_EMAIL=notes-bot@yourdomain.com
ACS_SERVICE_ACCOUNT_PASSWORD=your_service_account_password_here

# Azure AD app for ACS identity (typically reuses "Notely for Teams" app)
# This app must have the following delegated permissions with admin consent:
# - Azure Communication Services: Teams.ManageCalls
# - Azure Communication Services: Teams.ManageChats
ACS_IDENTITY_CLIENT_ID=your_shared_microsoft_app_id
ACS_IDENTITY_CLIENT_SECRET=your_shared_microsoft_app_secret
ACS_IDENTITY_TENANT_ID=your_microsoft_tenant_id

# Azure AD Object ID for the service account (required for getTokenForTeamsUser)
# Obtain via: az ad user show --id notes-bot@yourdomain.com --query id -o tsv
ACS_SERVICE_ACCOUNT_OBJECT_ID=your_service_account_object_id_guid

# ============================================================================
# CrowdSec - Intrusion Prevention System
# ============================================================================

# CrowdSec API key for firewall bouncer (host-level service)
# Generate with: docker exec <your-crowdsec-container> cscli bouncers add firewall-bouncer -o raw
# IMPORTANT: This key authenticates the host firewall bouncer to the CrowdSec container
CROWDSEC_API_KEY=your_crowdsec_api_key_here

# CrowdSec API key for nginx bouncer (container-level blocking)
# Generate with: docker exec <your-crowdsec-container> cscli bouncers add nginx-bouncer -o raw
# IMPORTANT: This key enables nginx to actively block banned IPs at the edge
# Without this key, CrowdSec only detects attacks but does not block them
CROWDSEC_BOUNCER_API_KEY=your_crowdsec_bouncer_api_key_here

# ============================================================================
# Diagnostics Analysis Service
# ============================================================================
# Shared secret between the support container and the host-side analyzer
# Generate with: openssl rand -hex 32
ANALYSIS_SERVICE_API_KEY=your_analysis_service_api_key_here

# Google reCAPTCHA (contact form spam protection)
# ============================================================================
# Get keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
