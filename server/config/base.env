# Notely Platform - Base Configuration
# This file contains default values that apply across all environments
# Override these values using configure-domains.sh flags
#
# Version controlled: YES
# Contains secrets: NO (secrets go in secrets.env)

# =============================================================================
# Service Port Configuration
# =============================================================================
# Default ports for all services (can be offset via --port-offset flag)

API_PORT=3200
API_HOST=0.0.0.0
AUTH_PORT=3201
USERS_PORT=3202
ADMIN_CONFIG_PORT=3206
ADMIN_DATABASE_PORT=3208
PORTAL_PORT=3204
CALENDAR_PORT=8003
WHISPER_PORT=8001
LLM_PORT=8002
GRAFANA_PORT=3130
LOKI_PORT=3100
DOCKER_MANAGER_PORT=8005
LOGS_PORT=3210
LICENSE_PORT=3211
SUMMARIES_PORT=3207
EMAIL_PORT=3214

# =============================================================================
# Deployment Mode Port Configuration
# =============================================================================
# External nginx ports by deployment mode
# Production: Standard ports (443/80)
# Staging: Non-standard ports (9443/9080) for staging environments
# Dev: Non-standard ports (8443/8080) for development environments
NGINX_HTTPS_PORT_PRODUCTION=443
NGINX_HTTP_PORT_PRODUCTION=80
NGINX_HTTPS_PORT_STAGING=9443
NGINX_HTTP_PORT_STAGING=9080
NGINX_HTTPS_PORT_DEV=8443
NGINX_HTTP_PORT_DEV=8081

# Default deployment mode (production, staging, dev)
DEPLOYMENT_MODE=production

# =============================================================================
# Subdomain Configuration
# =============================================================================
# Subdomain prefixes are combined with --base-domain flag to generate full
# domain names. For example, with --base-domain example.com:
#   api.example.com, portal.example.com, etc.
#
# IMPORTANT: --base-domain flag is REQUIRED when running configure-domains.sh
# No fallback domains are provided - fail fast if base domain is missing.

API_SUBDOMAIN=api
PORTAL_SUBDOMAIN=portal
CALENDAR_SUBDOMAIN=calendar
DOCS_SUBDOMAIN=docs
TRACKING_SUBDOMAIN=track
WS_SUBDOMAIN=ws
GET_SUBDOMAIN=get

# =============================================================================
# WebSocket Gateway Configuration
# =============================================================================
WS_GATEWAY_PORT=3217
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_CONNECTIONS_PER_USER=5

# =============================================================================
# OAuth Callback Paths
# =============================================================================
# These paths will be combined with API_DOMAIN to form complete callback URLs
# Example: https://api.yourdomain.com + /api/auth/microsoft/callback

# Microsoft OAuth callback paths
OAUTH_MICROSOFT_AUTH_PATH=/api/auth/microsoft/callback
OAUTH_MICROSOFT_CALENDAR_PATH=/api/outlook/callback
OAUTH_MICROSOFT_OUTLOOK_PATH=/api/outlook/callback

# Google OAuth callback paths
OAUTH_GOOGLE_AUTH_PATH=/api/auth/google/callback
OAUTH_GOOGLE_CALENDAR_PATH=/api/calendar/google/callback
OAUTH_GOOGLE_DESKTOP_AUTH_PATH=/api/desktop-auth/google/callback

# =============================================================================
# Desktop OAuth Configuration
# =============================================================================
AUTH_ENABLE_DESKTOP_OAUTH=true
AUTH_DESKTOP_STATE_TTL_SECONDS=600
AUTH_DESKTOP_LOGIN_TEMPLATE_VERSION=2025-10-21
AUTH_DESKTOP_DEFAULT_SCOPE="openid offline_access email profile"

# =============================================================================
# External API URL Configuration
# =============================================================================
# API_BASE_URL is used for OAuth callbacks and external-facing URLs
# These are dynamically generated by configure-domains.sh based on API_DOMAIN

# Placeholder - populated by configure-domains.sh from API_DOMAIN
# DO NOT SET HERE - will be overridden
API_BASE_URL=
# NOTE: CORS is handled at the nginx edge layer only - no application-level CORS config needed

# =============================================================================
# Service Internal URLs
# =============================================================================
# These are Docker container hostnames used for internal service-to-service communication
# Gateway is the API entrypoint, accessed at gateway:3200 from other containers

SERVICE_API_INTERNAL_URL=http://gateway:3200
SERVICE_PORTAL_INTERNAL_URL=http://notely-portal:3004
SERVICE_CALENDAR_INTERNAL_URL=http://notely-calendar:8003
LOGS_SERVICE_URL=http://logs:3210
LICENSE_SERVICE_URL=http://license:3211
SUMMARIES_SERVICE_URL=http://summaries:3207
SUPPORT_SERVICE_URL=http://support:3209
LLM_GATEWAY_URL=http://llm-gateway:8002

# Support Service
SUPPORT_PORT=3209

# Email Service
EMAIL_FROM_NAME=

# External service URLs (Python services)
SERVICE_WHISPER_URL=http://notely-whisper:8001
SERVICE_LLM_URL=http://notely-llm:8002

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_DB=notely_v3
POSTGRES_USER=notely_v3_admin
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Service-specific database users (passwords only in secrets.env)
POSTGRES_AUTH_USER=notely_auth_v3_user
POSTGRES_USERS_USER=notely_users_v3_user
POSTGRES_CALENDAR_USER=notely_calendar_v3_user
POSTGRES_MEETINGS_USER=notely_meetings_v3_user
POSTGRES_TRANSCRIPTS_USER=notely_transcripts_v3_user
POSTGRES_NOTES_USER=notely_notes_v3_user
POSTGRES_SUMMARIES_USER=notely_summaries_v3_user
POSTGRES_ADMIN_SERVICE_USER=notely_admin_v3_user
POSTGRES_ADMIN_DATABASE_USER=notely_admin_database_v3_user
POSTGRES_ACTIONS_USER=notely_actions_v3_user
POSTGRES_PORTAL_USER=notely_portal_v3_user
POSTGRES_SUPPORT_USER=notely_support_v3_user
POSTGRES_EMAIL_USER=notely_email_v3_user

# Admin database service defaults
ADMIN_DATABASE_ALLOWED_SCHEMAS=auth,users,calendar,meetings,transcripts,notes,summaries,admin,actions,portal,support
ADMIN_DATABASE_DEFAULT_DB=notely_v3
ADMIN_DATABASE_MAX_PAGE_SIZE=1000
ADMIN_DATABASE_DEFAULT_PAGE_SIZE=100

# NOTE: The gateway no longer connects directly to PostgreSQL.
# These credentials are consumed only by domain services that own their schemas.

# Connection Pool Configuration (CRITICAL for scaling)
# These values are tuned for 100K+ users and multiple API instances
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000
DB_POOL_ACQUIRE_TIMEOUT_MS=30000

# Database query timeouts
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=25000

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_KEY_PREFIX=v3:

# RabbitMQ configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=notely
RABBITMQ_VHOST=notely_vhost

# Redis connection pool
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000

# =============================================================================
# Caching Configuration
# =============================================================================
# Cache TTLs (in seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=1800
CACHE_TTL_LONG=3600
CACHE_TTL_USER_PROFILE=1800
CACHE_TTL_CALENDAR_EVENTS=600
CACHE_TTL_MEETINGS=300

# Cache strategy
CACHE_ENABLED=true
CACHE_KEY_PREFIX=v3:cache:

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
# Global rate limits (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Per-endpoint rate limits
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000

# Use Redis for distributed rate limiting
RATE_LIMIT_REDIS_ENABLED=true

# IP whitelist for rate limiting (comma-separated IPs, supports CIDR notation)
# Use for security scanning tools (e.g., OWASP ZAP) or internal health checks.
# Example: RATE_LIMIT_WHITELIST_IPS=127.0.0.1,::1,203.0.113.10,192.168.1.0/24
RATE_LIMIT_WHITELIST_IPS=127.0.0.1,::1

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TIMESTAMP=true

# Request logging
LOG_REQUESTS=true
LOG_RESPONSES=true
LOG_SLOW_REQUESTS=true
LOG_SLOW_THRESHOLD_MS=1000

# Sensitive fields to redact from logs
LOG_REDACT_FIELDS=password,token,authorization,secret,idempotency_key

# =============================================================================
# Security Configuration
# =============================================================================
# JWT Configuration
JWT_EXPIRES_IN=7d

# CORS - Handled at nginx edge layer only (see services/nginx/templates/*.conf.template)
# No application-level CORS configuration needed

# Session configuration
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=notely_v3_session
SESSION_SECURE=false

# Security headers
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=true
SECURITY_CSP_ENABLED=true

# Input validation
INPUT_VALIDATION_ENABLED=true
INPUT_SANITIZATION_ENABLED=true

# =============================================================================
# External Service Timeouts (CRITICAL for resilience)
# =============================================================================
# HTTP client defaults
HTTP_CLIENT_TIMEOUT_MS=5000
HTTP_CLIENT_RETRY_MAX=3
HTTP_CLIENT_RETRY_DELAY_MS=1000

# Microsoft Graph API
GRAPH_API_TIMEOUT_MS=10000
GRAPH_API_RETRY_MAX=3

# Google Calendar API
GOOGLE_API_TIMEOUT_MS=10000
GOOGLE_API_RETRY_MAX=3

# Whisper service
WHISPER_API_TIMEOUT_MS=120000
WHISPER_API_RETRY_MAX=1

# LLM service
LLM_API_TIMEOUT_MS=60000
LLM_API_RETRY_MAX=1

# =============================================================================
# Graceful Shutdown Configuration
# =============================================================================
SHUTDOWN_TIMEOUT_MS=30000
SHUTDOWN_DRAIN_REQUESTS=true

# =============================================================================
# Health Check Configuration
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_DB_ENABLED=true
HEALTH_CHECK_REDIS_ENABLED=true

# =============================================================================
# Calendar Auto-Sync Configuration 
# =============================================================================
CALENDAR_AUTO_SYNC_ENABLED=true
CALENDAR_AUTO_SYNC_CRON=*/15_*_*_*_*
CALENDAR_SYNC_MAX_USERS_PER_RUN=50
CALENDAR_SYNC_USER_DELAY=500
CALENDAR_SYNC_THROTTLE_BACKOFF=60000

# =============================================================================
# Teams Meeting Join Configuration 
# =============================================================================
TEAMS_DEFAULT_JOIN_MODE=graph
USE_ACS_BY_DEFAULT=false
TEAMS_JOIN_MAX_ATTEMPTS=5
TEAMS_JOIN_LEAD_SECONDS=30
TEAMS_JOIN_CLAIM_HOLD_MINUTES=2
TEAMS_JOIN_STALE_MINUTES=60
TEAMS_CALLBACK_TOKEN_TTL_MINUTES=120

# =============================================================================
# ACS Configuration
# =============================================================================
ACS_DISPLAY_PREFIX_DEFAULT=Note-taker
ACS_CAPTIONS_LANG=en-US
ACS_TOKEN_TTL_MINUTES=120
ACS_FROM_NUMBER=
ACS_TRANSCRIPTION_LOCALE=en-US
ACS_JOINER_CALLBACK_URI=
ACS_JOINER_MAX_CONCURRENT_JOBS=2
ACS_JOINER_POLL_SECONDS=20
ACS_JOINER_PUBLIC_BASE_URL=
ACS_CAPTION_SEGMENT_LIMIT=500
ACS_JOINER_FORWARD_URL=http://acs-joiner:4090/api/ca/events
ACS_JOINER_FORWARD_TIMEOUT_MS=10000
ACS_JOINER_LOG_LEVEL=debug

# =============================================================================
# Observability (Loki / Grafana)
# =============================================================================
LOKI_RETENTION_DAYS=7
LOKI_BASE_URL=http://loki:3100
# Grafana admin credentials — MUST be set in config/secrets.dev.env or config/secrets.prod.env.
# The platform will refuse to start if these are unset in the merged env.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_ROOT_URL and NEXT_PUBLIC_GRAFANA_URL are dynamically generated
# by configure-domains.sh based on PORTAL_DOMAIN (e.g., https://portal.yourdomain.com/grafana)
GRAFANA_INTERNAL_URL=http://grafana:3000

# =============================================================================
# Node.js Configuration
# =============================================================================
NODE_OPTIONS=--max-old-space-size=4096
NODE_ENV=development

# =============================================================================
# SSL Configuration
# =============================================================================
# SSL mode: self-signed, bring-your-own, letsencrypt
SSL_MODE=self-signed

# Path to SSL certificates (relative to services/nginx)
SSL_CERT_PATH=ssl/certs/server.crt
SSL_KEY_PATH=ssl/private/server.key

# Let's Encrypt configuration (if SSL_MODE=letsencrypt)
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=false
