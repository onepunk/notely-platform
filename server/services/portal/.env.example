PORTAL_DOMAIN=portal.yourdomain.com
PORTAL_SUBDOMAIN=portal

# API Configuration
API_BASE_URL=http://notely-api:3000
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_BASE_URL=https://portal.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://portal.yourdomain.com

# Authentication / Secrets (override via secrets.env or docker env)
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# Database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# OAuth (optional overrides)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
