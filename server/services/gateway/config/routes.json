{
  "/api/auth": {
    "service": "auth",
    "pathRewrite": {
      "^/api/auth": "/api/auth"
    },
    "transformations": {
      "request": {
        "enrichContext": true
      },
      "response": {
        "filterSensitive": false,
        "normalizeDates": true,
        "normalizeCasing": false
      }
    },
    "circuitBreaker": {
      "enabled": true,
      "failureThreshold": 5,
      "successThreshold": 2,
      "cooldownPeriodMs": 15000,
      "fallbackStatus": 503,
      "fallbackBody": {
        "error": "auth_service_unavailable",
        "message": "Authentication service temporarily unavailable. Please retry shortly."
      }
    }
  },
