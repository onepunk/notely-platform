# License Service Configuration
LICENSE_PORT=3210
NODE_ENV=development

# Database (notely_v3)
DB_HOST=notely-postgres
DB_PORT=5432
DB_NAME=notely_v3
DB_USER=notely_user
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=notely-redis
REDIS_PORT=6379

# JWT
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nYour-Public-Key-Here\n-----END PUBLIC KEY-----
JWT_EXPIRES_IN=1h

# License Configuration
LICENSE_ENCRYPTION_KEY=your_encryption_key_here

# Logging
LOG_LEVEL=info
