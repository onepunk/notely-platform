# Main Website Configuration for ${BASE_DOMAIN}
# Handles www redirect and main website

# HTTP server - redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${BASE_DOMAIN} www.${BASE_DOMAIN};

    # Let's Encrypt challenge location
    location /.well-known/acme-challenge/ {
        root /etc/nginx/ssl/webroot;
        try_files $uri =404;
    }

    # Redirect to HTTPS
    location / {
        return 301 https://${BASE_DOMAIN}$request_uri;
    }
}

# HTTPS server for main website
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${BASE_DOMAIN} www.${BASE_DOMAIN};

    # SSL configuration
    ssl_certificate /etc/nginx/ssl/certs/${BASE_DOMAIN}.crt;
    ssl_certificate_key /etc/nginx/ssl/private/${BASE_DOMAIN}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Strong cipher suite - forward secrecy required, no weak ciphers
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # HSTS
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Content Security Policy - marketing website with API endpoints for beta signup
    # Allows CDN resources: Swiper.js (cdn.jsdelivr.net), Google Fonts, Google Analytics, and reCAPTCHA v3
    # Note: 'unsafe-inline' for scripts needed for release notes page and other inline JS
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.google.com/recaptcha/; frame-src https://www.google.com/recaptcha/; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;

    # Redirect www to non-www
    if ($host = www.${BASE_DOMAIN}) {
        return 301 https://${BASE_DOMAIN}$request_uri;
    }

    # Redirect /get/ to get subdomain (preserves port for dev/prod)
    location ^~ /get {
        return 301 $scheme://get.$http_host/;
    }

    # Health check
    location /health {
        access_log off;
        add_header 'Content-Type' 'application/json';
        return 200 '{"status":"healthy","service":"website","timestamp":"$time_iso8601"}';
    }

    # API proxy for public license endpoints (used by /plans/ page)
    # Only exposes /api/license/* - minimal surface area
    location ^~ /api/license/ {
        limit_req zone=general burst=10 nodelay;
        limit_conn addr 5;

        proxy_pass http://gateway/api/license/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # API proxy for support endpoints (beta signup + contact form)
    location ^~ /api/support/ {
        limit_req zone=general burst=5 nodelay;
        limit_conn addr 3;

        proxy_pass http://gateway/api/support/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Custom 404 error page
    error_page 404 /404.html;

    # Shared includes for SSI (needed since root is now yourdomain.com/ subdirectory)
    location /includes/ {
        alias /var/www/website/includes/;
        internal;
    }

    # Shared CSS assets (single source of truth for both domains)
    location /shared/css/ {
        alias /var/www/website/includes/css/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Main website - serve static content from webroot
    location / {
        root /var/www/website/yourdomain.com;
        index index.html;
        try_files $uri $uri/ =404;

        # Enable Server-Side Includes for shared header/footer
        ssi on;
        ssi_types text/html;

        # Cache static assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 30d;
            add_header Cache-Control "public, immutable";
        }
    }
}
