# Download Portal Configuration for ${GET_DOMAIN}
# Serves desktop client downloads - PUBLIC ACCESS with rate limiting

# HTTP server - redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${GET_DOMAIN};

    # Let's Encrypt challenge location
    location /.well-known/acme-challenge/ {
        root /etc/nginx/ssl/webroot;
        try_files $uri =404;
    }

    # Redirect to HTTPS
    location / {
        return 301 https://${GET_DOMAIN}$request_uri;
    }
}

# HTTPS server for Downloads
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${GET_DOMAIN};

    # SSL configuration - uses wildcard cert
    ssl_certificate /etc/nginx/ssl/certs/${BASE_DOMAIN}.crt;
    ssl_certificate_key /etc/nginx/ssl/private/${BASE_DOMAIN}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Strong cipher suite - forward secrecy required, no weak ciphers
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # HSTS
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Content Security Policy - download page with beta signup form and shared header (uses Google Fonts)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;

    # Health check
    location /health {
        access_log off;
        add_header 'Content-Type' 'application/json';
        return 200 '{"status":"healthy","service":"get","timestamp":"$time_iso8601"}';
    }

    # Redirect stale /get/ breadcrumb links to root
    location = /get/ {
        return 301 /;
    }
    location = /get {
        return 301 /;
    }

    # API proxy for support endpoints (beta signup form)
    location ^~ /api/support/ {
        limit_req zone=general burst=5 nodelay;
        limit_conn addr 3;

        set $upstream_gateway gateway:3200;
        proxy_pass http://$upstream_gateway;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # API proxy for releases endpoint (same-origin to avoid CORS/CSP issues)
    location /api/portal/releases/ {
        limit_req zone=general burst=10 nodelay;

        # Use variable to force DNS re-resolution on each request
        set $upstream_gateway gateway:3200;
        proxy_pass http://$upstream_gateway;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Release files - PUBLIC with rate limiting
    # Serves from /var/www/website/get.yourdomain.com/releases/{product}/{platform}/
    location /releases/ {
        # Rate limiting for downloads (5 requests per minute per IP)
        limit_req zone=downloads burst=5 nodelay;
        limit_conn addr 3;

        alias /var/www/website/get.yourdomain.com/releases/;

        # Disable directory listing
        autoindex off;

        # Set content disposition for downloads
        add_header Content-Disposition "attachment" always;

        # Cache control for release files
        expires 1h;
        add_header Cache-Control "public, must-revalidate";

        # Enable sendfile for efficient file transfer
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;

        # Limit download rate (10MB/s per connection)
        limit_rate 10m;

        # Signed URL protection for installer binaries
        # Requires HMAC-signed URLs with expiry for binary downloads
        # Auto-updater YAML files and electron-updater UA are allowed through
        location ~* /releases/.*\.(exe|msi|dmg|pkg|AppImage|deb)$ {
            access_by_lua_block {
                local signed_downloads = require("signed_downloads")
                signed_downloads.check()
            }

            # Prevent search engines from indexing direct download links
            add_header X-Robots-Tag "noindex, nofollow" always;
            add_header Content-Disposition "attachment" always;

            # Inherit rate limiting from parent
            limit_rate 10m;
        }
    }

    # Desktop app component downloads (audio-engine binary, speech models)
    # Large files (~1GB total) downloaded on first app launch
    # Client base URL: https://get.yourdomain.com/components
    location /components/ {
        alias /var/www/website/get.yourdomain.com/components/;

        # Disable directory listing
        autoindex off;

        # Enable byte-range requests for download resume support
        add_header Accept-Ranges bytes always;

        # Allow CORS for Electron app
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Range" always;

        # Handle CORS preflight
        if ($request_method = OPTIONS) {
            return 204;
        }

        # Enable sendfile for efficient large file transfer
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;

        # Don't cache manifest (may be updated when new components are published)
        location = /components/manifest.json {
            alias /var/www/website/get.yourdomain.com/components/manifest.json;
            add_header Cache-Control "no-cache, must-revalidate" always;
            add_header Accept-Ranges bytes always;
            add_header Access-Control-Allow-Origin "*" always;
        }

        # Cache binary and model files (immutable content, hash-verified by client)
        location ~* /components/.*\.(bin|exe)$ {
            expires 365d;
            add_header Cache-Control "public, immutable" always;
            add_header Accept-Ranges bytes always;
            add_header Access-Control-Allow-Origin "*" always;
        }

        # Rate limit downloads - allow burst for initial app setup
        # Desktop app downloads manifest + binary + model files on first launch
        limit_req zone=general burst=20 nodelay;
        limit_conn addr 5;
    }

    # Shared includes (header/footer) from main webroot for SSI
    location /includes/ {
        alias /var/www/website/includes/;
        internal;  # Only accessible via SSI, not direct requests
    }

    # Static assets for the download page
    location /assets/ {
        alias /var/www/website/get.yourdomain.com/assets/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Lib assets (CSS frameworks, etc.)
    location /lib/ {
        alias /var/www/website/get.yourdomain.com/lib/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Shared CSS assets (single source of truth for both domains)
    location /shared/css/ {
        alias /var/www/website/includes/css/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Main download page
    location / {
        root /var/www/website/get.yourdomain.com;
        index index.html;
        try_files $uri $uri/ /index.html;

        # Enable Server-Side Includes for shared header/footer
        ssi on;
        ssi_types text/html;

        # Rate limiting for page views (lighter limit)
        limit_req zone=general burst=20 nodelay;

        # Cache static assets within this location
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 30d;
            add_header Cache-Control "public, immutable";
        }
    }

    # Block access to sensitive files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
