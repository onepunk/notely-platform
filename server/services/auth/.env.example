# Auth Service Configuration
AUTH_PORT=3201
NODE_ENV=development

# Database (notely_v3)
DB_HOST=notely-postgres
DB_PORT=5432
DB_NAME=notely_v3
DB_USER=notely_user
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=notely-redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=1h

# Logging
LOG_LEVEL=info
